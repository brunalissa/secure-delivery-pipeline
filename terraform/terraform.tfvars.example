# ═══════════════════════════════════════════════════════════════════════════════
# terraform.tfvars.example — Example Variable Values
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is automatically loaded by Terraform. It is .gitignored
# so that sensitive values are never committed to the repository.
#
# NEVER commit terraform.tfvars with real secrets to the repository!
# Use AWS SSM Parameter Store or Secrets Manager for sensitive data.
# ═══════════════════════════════════════════════════════════════════════════════

# Environment name: dev, staging, or prod
environment = "dev"

# AWS region
aws_region = "us-east-1"

# VPC network configuration
vpc_cidr              = "10.0.0.0/16"
availability_zones     = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.3.0/24", "10.0.4.0/24"]

# EC2 configuration
instance_type   = "t3.small"
key_name        = "your-ssh-key-pair-name"
min_instances   = 2
max_instances   = 4